# Big Satellite Data & Model Checkpoints (Do NOT commit huge binaries)
*.tiff
*.tif
*.nc
*.hdf
*.tar.gz
*.zip
*.onnx
*.pt
*.pth
*.bin
data/outputs/*
!data/outputs/.gitkeep
# Written by a pass or by the downlink scheduler (src/pyFlows/workflow.py) and rewritten on every run
src/fleet_alerts/
src/downlink/queues/
src/sent/
src/rawImages/
src/processing/
src/noShipDetected/
src/deleted/
# All datasets are rebuilt by `python scripts/setup_data.py` (see docs/SETUP.md). The entries without a
# trailing slash also match the junctions / symlinks that --data-root creates.
data/sample_bundle/
data/eval_bundle
data/heldout_bundle
data/real

# The flight model is tiny (59 KB INT8) and must ship with the applet
!applet/models/*.onnx

# Local editor / agent settings
.claude/
data/raw/*
!data/raw/.gitkeep
