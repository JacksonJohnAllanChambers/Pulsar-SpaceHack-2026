# Big Satellite Data & Model Checkpoints (Do NOT commit huge binaries)
*.tiff
*.tif
*.nc
*.hdf
*.tar.gz
*.zip
*.onnx
*.pt
*.pth
*.bin
data/outputs/*
!data/outputs/.gitkeep
# Written by the applet pass or downlink scheduler and rewritten on every run
src/fleet_alerts/
src/downlink/queues/
src/sent/
.keys/
# All datasets are rebuilt by `python scripts/setup_data.py` (see docs/SETUP.md). The entries without a
# trailing slash also match the junctions / symlinks that --data-root creates.
data/sample_bundle/
data/eval_bundle
data/heldout_bundle
data/real

# The flight model is tiny (59 KB INT8) and must ship with the applet
!applet/models/*.onnx

# Local editor / agent settings
.claude/
data/raw/*
!data/raw/.gitkeep

# Generated cinematic media and render intermediates
/.animation/

# Committed once by accident: a render virtualenv
.cpython-render-venv/
